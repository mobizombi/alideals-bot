{
  "manifest_version": 3,
  "name": "מציאון – דילים יומיים",
  "short_name": "מציאון",
  "version": "1.0.0",
  "description": "דילים חמים מאליאקספרס כל יום, ישר מהדפדפן. בלי הרשמה, בלי מעקב אחרי גלישה.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "מציאון – דילים יומיים",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://mobizombi.github.io/*"],
  "content_scripts": [
    {
      "matches": ["https://*.aliexpress.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
